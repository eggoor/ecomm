{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${command:cmake.buildDirectory}", "--target", "ecomm"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "linux": {
                "problemMatcher": "$gcc"
            },
            "osx": {
                "problemMatcher": "$gcc"
            },
            "windows": {
                "problemMatcher": "$msCompile"
            }
        }
    ]
}